"VertexLitGeneric"
{
	"$baseTexture" "models/zerosiki/attackprojectiles/nuclearbomb/cart_bomb"
                "$bumpmap"     "models/zerosiki/attackprojectiles/nuclearbomb/cart_bomb_normal"

	$selfillum 1
	$selfillummask "models\props_trainyard\cart_bomb_selfillum"

	"$phong" "1"
	"$phongexponent" "4"
	"$phongboost" ".9"	
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongfresnelranges"	"[2 1 6]"
	
	// Rim lighting parameters
	"$rimlight" "1"												// To enable rim lighting (requires phong)
	"$rimlightexponent" "2"										// Exponent for phong component of rim lighting	
	"$rimlightboost" ".2"										// Boost for ambient cube component of rim lighting


}
